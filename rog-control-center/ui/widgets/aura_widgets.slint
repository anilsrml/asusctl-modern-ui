import { Theme } from "../theme.slint";
import { Toggle } from "kit.slint";

// One selectable effect in the mode grid
component ModeChip inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked <=> touch.clicked;
    border-radius: Theme.radius;
    min-height: 36px;
    background: selected ? Theme.accent-bg : touch.has-hover ? Theme.border : Theme.surface;
    border-width: 1px;
    border-color: selected ? Theme.accent : transparent;
    animate background { duration: 120ms; }

    Text {
        text: root.text;
        color: root.selected ? Theme.accent-text : Theme.text-secondary;
        font-size: Theme.font-body;
        font-weight: root.selected ? 500 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    touch := TouchArea { }
}

// Effects laid out in rows of `columns`, built only from the given model
export component ModeChips inherits VerticalLayout {
    in property <[string]> model;
    in property <int> columns: 4;
    in-out property <int> current-index;
    callback selected(int);
    property <int> rows: Math.ceil(model.length / columns);
    spacing: 8px;

    for r in root.rows: HorizontalLayout {
        spacing: 8px;
        for c in root.columns: Rectangle {
            horizontal-stretch: 1;
            min-width: 0px;
            min-height: 36px;
            if r * root.columns + c < root.model.length: ModeChip {
                text: root.model[r * root.columns + c];
                selected: r * root.columns + c == root.current-index;
                clicked => {
                    if (r * root.columns + c != root.current-index) {
                        root.current-index = r * root.columns + c;
                        root.selected(r * root.columns + c);
                    }
                }
            }
        }
    }
}

// Small caption above a control
export component FieldLabel inherits Text {
    color: Theme.text-secondary;
    font-size: Theme.font-small;
}

// ToggleRow look-alike without wrapped text. Wrapped labels inside a repeated
// row create a size binding loop under the page's ScrollView.
export component PowerRow inherits Rectangle {
    in property <string> title;
    in property <string> hint;
    in-out property <bool> checked <=> toggle.checked;
    callback toggled(bool);
    min-height: 44px;

    HorizontalLayout {
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            horizontal-stretch: 1;
            Text {
                text: root.title;
                color: Theme.text;
                font-size: Theme.font-body;
                overflow: elide;
            }
            Text {
                text: root.hint;
                color: Theme.text-secondary;
                font-size: Theme.font-small;
                overflow: elide;
            }
        }
        VerticalLayout {
            alignment: center;
            toggle := Toggle {
                toggled(value) => {
                    root.toggled(value);
                }
            }
        }
    }
}
