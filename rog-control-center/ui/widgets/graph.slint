import { Theme } from "../theme.slint";

export struct Node { x: length, y: length}

// Editable fan curve. X is temperature in degrees C (0..100), Y is raw PWM (0..255)
// shown as a percentage. Dragging asks `clamp-point` (Rust) for the allowed
// position so the curve stays monotonic; the result is reported via `moved`.
export component Graph inherits Rectangle {
    in property <[Node]> nodes;
    in property <bool> editable: true;
    in property <Node> node_min: { x: 0px, y: 0px };
    in property <Node> node_max: { x: 100px, y: 255px };
    pure callback clamp-point([Node], int, Node) -> Node;
    callback moved(int, Node);
    property <length> pad-left: 40px;
    property <length> pad-bottom: 38px;
    property <length> pad-top: 14px;
    property <length> pad-right: 20px;
    property <length> axis_font_size: Theme.font-small;

    // Shown in the header: value of the hovered or dragged point.
    out property <string> readout: root.active >= 0 && root.active < root.nodes.length ? @tr("{} °C → {} %", Math.round(root.nodes[root.active].x / 1px), Math.round(root.nodes[root.active].y / 1px / 255 * 100)) : "";
    in-out property <int> active: -1;

    Text {
        x: 0px;
        y: 0px;
        text: "%";
        color: Theme.text-secondary;
        font-size: root.axis_font_size;
    }

    Text {
        x: root.pad-left + (root.width - root.pad-left - root.pad-right) / 2 - self.width / 2;
        y: root.height - self.height;
        text: @tr("°C");
        color: Theme.text-secondary;
        font-size: root.axis_font_size;
    }

    graph := Rectangle {
        width: root.width - root.pad-left - root.pad-right;
        height: root.height - root.pad-top - root.pad-bottom;
        x: root.pad-left;
        y: root.pad-top;
        pure public function scale_x_to_graph(x: length) -> length {
            ((x - node_min.x) / (node_max.x - node_min.x)) * graph.width
        }
        pure public function scale_y_to_graph(y: length) -> length {
            ((y - node_min.y) / (node_max.y - node_min.y)) * graph.height
        }
        pure public function scale_x_to_node(x: length) -> length {
            (x / graph.width) * (node_max.x - node_min.x)
        }
        pure public function scale_y_to_node(y: length) -> length {
            (y / graph.height) * (node_max.y - node_min.y)
        }

        for n in 11: Rectangle {
            x: scale_x_to_graph(n * 10px);
            width: 1px;
            height: graph.height;
            background: Theme.border;
        }

        for n in 11: Text {
            color: Theme.text-secondary;
            font-size: root.axis_font_size;
            text: "\{n * 10}";
            x: scale_x_to_graph(n * 10px) - self.width / 2;
            y: graph.height + 4px;
        }

        for n in 11: Rectangle {
            y: graph.height - scale_y_to_graph(n * 25.5px);
            width: graph.width;
            height: 1px;
            background: Theme.border;
        }

        for n in 11: Text {
            color: Theme.text-secondary;
            font-size: root.axis_font_size;
            text: "\{n * 10}";
            x: -self.width - 6px;
            y: graph.height - scale_y_to_graph(n * 25.5px) - self.height / 2;
        }

        for l[idx] in nodes: Rectangle {
            if idx + 1 != nodes.length: Path {
                viewbox-width: self.width / 1px;
                viewbox-height: self.height / 1px;
                stroke: root.editable ? Theme.accent : Theme.text-muted;
                stroke-width: 2px;
                MoveTo {
                    x: scale_x_to_graph(nodes[idx].x) / 1px;
                    y: graph.height / 1px - scale_y_to_graph(nodes[idx].y) / 1px;
                }

                LineTo {
                    x: scale_x_to_graph(nodes[idx + 1].x) / 1px;
                    y: graph.height / 1px - scale_y_to_graph(nodes[idx + 1].y) / 1px;
                }
            }
        }

        for n[idx] in nodes: point := Rectangle {
            property <bool> hot: touch.has-hover || touch.pressed;
            property <Node> start;
            x: scale_x_to_graph(n.x) - self.width / 2;
            y: graph.height - scale_y_to_graph(n.y) - self.height / 2;
            width: hot ? 18px : 14px;
            height: self.width;
            border-radius: self.width / 2;
            background: root.editable ? Theme.accent : Theme.text-muted;
            border-color: Theme.surface-raised;
            border-width: 2px;
            animate width { duration: 100ms; }

            touch := TouchArea {
                enabled: root.editable;
                mouse-cursor: move;
                changed has-hover => {
                    if self.has-hover {
                        root.active = idx;
                    } else if !self.pressed && root.active == idx {
                        root.active = -1;
                    }
                }
                pointer-event(e) => {
                    if e.kind == PointerEventKind.down {
                        point.start = nodes[idx];
                        root.active = idx;
                    } else if e.kind == PointerEventKind.up && !self.has-hover && root.active == idx {
                        root.active = -1;
                    }
                }
                moved => {
                    if self.pressed {
                        root.moved(idx, root.clamp-point(nodes, idx, {
                            x: point.start.x + scale_x_to_node(self.mouse-x - self.pressed-x),
                            y: point.start.y - scale_y_to_node(self.mouse-y - self.pressed-y),
                        }));
                    }
                }
            }
        }
    }

    // Floating value tip for the active point.
    if root.active >= 0 && root.active < root.nodes.length: Rectangle {
        background: Theme.surface;
        border-color: Theme.border-strong;
        border-width: 1px;
        border-radius: Theme.radius;
        width: tip-label.preferred-width + 16px;
        height: tip-label.preferred-height + 8px;
        x: min(max(root.pad-left + graph.scale_x_to_graph(root.nodes[root.active].x) - self.width / 2, 0px), root.width - self.width);
        y: max(root.pad-top + graph.height - graph.scale_y_to_graph(root.nodes[root.active].y) - self.height - 14px, 0px);
        tip-label := Text {
            text: root.readout;
            color: Theme.text;
            font-size: Theme.font-small;
        }
    }
}
