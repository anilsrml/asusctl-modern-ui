import { Theme } from "../theme.slint";
import { PowerRow } from "aura_widgets.slint";

// Power-state switches for one lighting zone. Only the states the device
// supports are shown (`show-shutdown` is off where the firmware ignores it).
export component AuraZonePower inherits VerticalLayout {
    in property <string> zone-title;
    in property <bool> show-shutdown: true;
    in-out property <bool> boot-checked;
    in-out property <bool> awake-checked;
    in-out property <bool> sleep-checked;
    in-out property <bool> shutdown-checked;
    callback boot-toggled(bool);
    callback awake-toggled(bool);
    callback sleep-toggled(bool);
    callback shutdown-toggled(bool);
    spacing: 2px;

    if root.zone-title != "": Text {
        text: root.zone-title;
        color: Theme.text-secondary;
        font-size: Theme.font-small;
        font-weight: 500;
    }
    PowerRow {
        title: @tr("Boot");
        hint: @tr("Backlight is on while the laptop starts up");
        checked <=> root.boot-checked;
        toggled(value) => {
            root.boot-toggled(value);
        }
    }
    PowerRow {
        title: @tr("Awake");
        hint: @tr("Backlight is on while the laptop is running");
        checked <=> root.awake-checked;
        toggled(value) => {
            root.awake-toggled(value);
        }
    }
    PowerRow {
        title: @tr("Sleep");
        hint: @tr("Backlight stays on while the laptop sleeps");
        checked <=> root.sleep-checked;
        toggled(value) => {
            root.sleep-toggled(value);
        }
    }
    if root.show-shutdown: PowerRow {
        title: @tr("Shutdown");
        hint: @tr("Backlight stays on after the laptop shuts down");
        checked <=> root.shutdown-checked;
        toggled(value) => {
            root.shutdown-toggled(value);
        }
    }
}
