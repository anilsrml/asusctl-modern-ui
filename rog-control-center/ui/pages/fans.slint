import { Button } from "std-widgets.slint";
import { Graph, Node } from "../widgets/graph.slint";
import { Theme } from "../theme.slint";
import { Card, SegmentedControl, ToggleRow } from "../widgets/kit.slint";
import { Profile, FanType, FanPageData } from "../types/fan_types.slint";

export component PageFans inherits Rectangle {
    // 0 Quiet, 1 Balanced, 2 Performance (matches FanPageData helpers)
    in-out property <int> profile-index: 1;
    in-out property <int> fan-index: 0;
    property <Profile> profile: profile-index == 0 ? Profile.Quiet : profile-index == 1 ? Profile.Balanced : Profile.Performance;
    property <FanType> fan-type: fan-index == 0 ? FanType.CPU : fan-index == 1 ? FanType.GPU : FanType.Middle;
    property <bool> fan-available: fan-index == 0 ? FanPageData.cpu_fan_available : fan-index == 1 ? FanPageData.gpu_fan_available : FanPageData.mid_fan_available;
    property <bool> use-custom: FanPageData.enabled_for(profile-index, fan-index);
    property <[Node]> nodes: FanPageData.nodes_for(profile-index, fan-index);

    function apply() {
        FanPageData.set_fan_data(root.fan-type, root.profile, FanPageData.enabled_for(root.profile-index, root.fan-index), FanPageData.nodes_for(root.profile-index, root.fan-index));
    }

    background: Theme.window-bg;

    VerticalLayout {
        padding: Theme.pad;
        spacing: Theme.gap;

        SegmentedControl {
            model: [@tr("Quiet"), @tr("Balanced"), @tr("Performance")];
            current-index <=> root.profile-index;
        }

        SegmentedControl {
            model: root.fan-index == 2 || FanPageData.mid_fan_available ? [@tr("CPU"), @tr("GPU"), @tr("Mid")] : [@tr("CPU"), @tr("GPU")];
            current-index <=> root.fan-index;
        }

        Card {
            title: @tr("Fan curve");
            vertical-stretch: 1;
            min-height: 240px;

            if root.fan-available: Graph {
                nodes: root.nodes;
                editable: root.use-custom;
                clamp-point(nodes, idx, node) => {
                    FanPageData.clamp_point(nodes, idx, node)
                }
                moved(idx, node) => {
                    FanPageData.set_node_for(root.profile-index, root.fan-index, idx, node);
                }
            }
            if !root.fan-available: Rectangle {
                Text {
                    text: @tr("This fan is not available on this machine");
                    color: Theme.text-secondary;
                    font-size: Theme.font-body;
                }
            }
        }

        Card {
            ToggleRow {
                title: @tr("Use custom curve");
                hint: root.use-custom ? @tr("Drag the points to shape the curve, then apply.") : @tr("Off: the firmware default curve is used.");
                enabled: root.fan-available;
                checked: root.use-custom;
                toggled(value) => {
                    FanPageData.set_enabled_for(root.profile-index, root.fan-index, value);
                    root.apply();
                }
            }

            HorizontalLayout {
                alignment: end;
                spacing: Theme.gap;
                Button {
                    text: @tr("Reset to default");
                    enabled: root.fan-available;
                    clicked => {
                        FanPageData.set_profile_default(root.profile);
                    }
                }

                Button {
                    text: @tr("Apply");
                    primary: true;
                    enabled: root.fan-available && root.use-custom;
                    clicked => {
                        root.apply();
                    }
                }
            }
        }
    }
}
