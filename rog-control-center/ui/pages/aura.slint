import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Card, SegmentedControl } from "../widgets/kit.slint";
import { ModeChips, FieldLabel } from "../widgets/aura_widgets.slint";
import { ColourSlider } from "../widgets/colour_picker.slint";
import { AuraZonePower } from "../widgets/aura_power.slint";
import { AuraPageData, AuraDevType, PowerZones, LaptopAuraPower, AuraEffect } from "../types/aura_types.slint";

export component PageAura inherits Rectangle {
    // Bumped to make the colour pickers re-read the colours asusd reported
    property <int> colour_refresh: 0;
    property <bool> has_power: AuraPageData.led_power.states.length > 0 && (AuraPageData.device_type == AuraDevType.New || AuraPageData.device_type == AuraDevType.Tuf || AuraPageData.device_type == AuraDevType.Old);
    property <bool> is_old: AuraPageData.device_type == AuraDevType.Old;
    callback external_colour_change();
    external_colour_change() => {
        root.colour_refresh += 1;
    }

    function apply(colour1: color, colour2: color, speed: int, direction: int) {
        AuraPageData.apply_effect({
            mode: AuraPageData.led_mode_data.mode,
            zone: AuraPageData.led_mode_data.zone,
            colour1: colour1,
            colour2: colour2,
            speed: speed,
            direction: direction,
        });
    }

    background: Theme.window-bg;
    clip: true;

    ScrollView {
        VerticalLayout {
            padding: 12px;
            spacing: Theme.gap;
            alignment: start;

            Card {
                title: @tr("Effect");
                if AuraPageData.available_mode_names.length == 0: Text {
                    text: @tr("No lighting effects reported by the daemon");
                    color: Theme.text-secondary;
                    font-size: Theme.font-body;
                }
                if AuraPageData.available_mode_names.length > 0: ModeChips {
                    model: AuraPageData.available_mode_names;
                    current-index <=> AuraPageData.current_available_mode;
                    selected(index) => {
                        AuraPageData.apply_effect({
                            mode: AuraPageData.supported_basic_modes[index],
                            zone: AuraPageData.led_mode_data.zone,
                            colour1: AuraPageData.led_mode_data.colour1,
                            colour2: AuraPageData.led_mode_data.colour2,
                            speed: AuraPageData.led_mode_data.speed,
                            direction: AuraPageData.led_mode_data.direction,
                        });
                    }
                }
                if AuraPageData.speed_enabled: VerticalLayout {
                    spacing: 4px;
                    padding-top: 6px;
                    FieldLabel { text: @tr("Speed"); }
                    SegmentedControl {
                        model: AuraPageData.speed_names;
                        current-index <=> AuraPageData.speed;
                        selected(index) => {
                            root.apply(AuraPageData.led_mode_data.colour1, AuraPageData.led_mode_data.colour2, index, AuraPageData.led_mode_data.direction);
                        }
                    }
                }
                if AuraPageData.direction_enabled: VerticalLayout {
                    spacing: 4px;
                    padding-top: 6px;
                    FieldLabel { text: @tr("Direction"); }
                    SegmentedControl {
                        model: AuraPageData.direction_names;
                        current-index <=> AuraPageData.direction;
                        selected(index) => {
                            root.apply(AuraPageData.led_mode_data.colour1, AuraPageData.led_mode_data.colour2, AuraPageData.led_mode_data.speed, index);
                        }
                    }
                }
            }

            if AuraPageData.colour1_enabled: Card {
                title: @tr("Colour");
                HorizontalLayout {
                    spacing: 20px;
                    VerticalLayout {
                        spacing: 4px;
                        if AuraPageData.colour2_enabled: FieldLabel { text: @tr("Colour 1"); }
                        ColourSlider {
                            refresh: root.colour_refresh;
                            final_colour <=> AuraPageData.color1;
                            colourbox <=> AuraPageData.colorbox1;
                            set_hex_from_colour(c) => { return AuraPageData.cb_hex_from_colour(c); }
                            hex_to_colour(s) => { return AuraPageData.cb_hex_to_colour(s); }
                            released => {
                                root.apply(AuraPageData.color1, AuraPageData.led_mode_data.colour2, AuraPageData.led_mode_data.speed, AuraPageData.led_mode_data.direction);
                            }
                        }
                    }
                    if AuraPageData.colour2_enabled: VerticalLayout {
                        spacing: 4px;
                        FieldLabel { text: @tr("Colour 2"); }
                        ColourSlider {
                            refresh: root.colour_refresh;
                            final_colour <=> AuraPageData.color2;
                            colourbox <=> AuraPageData.colorbox2;
                            set_hex_from_colour(c) => { return AuraPageData.cb_hex_from_colour(c); }
                            hex_to_colour(s) => { return AuraPageData.cb_hex_to_colour(s); }
                            released => {
                                root.apply(AuraPageData.led_mode_data.colour1, AuraPageData.color2, AuraPageData.led_mode_data.speed, AuraPageData.led_mode_data.direction);
                            }
                        }
                    }
                }
            }

            Card {
                title: @tr("Brightness");
                SegmentedControl {
                    model: AuraPageData.brightness_names;
                    current-index <=> AuraPageData.brightness;
                    selected(index) => {
                        AuraPageData.cb_brightness(index);
                    }
                }
            }

            if root.has_power: Card {
                title: @tr("Power states");
                if root.is_old && AuraPageData.power_zone_names_old.length > 1: SegmentedControl {
                    model: AuraPageData.power_zone_names_old;
                    selected(index) => {
                        AuraPageData.led_power.states[0].zone = AuraPageData.supported_power_zones[index];
                        AuraPageData.cb_led_power(AuraPageData.led_power);
                    }
                }
                for state[idx] in AuraPageData.led_power.states: zone := AuraZonePower {
                    zone-title: (!root.is_old && (AuraPageData.led_power.states.length > 1 || AuraPageData.device_type == AuraDevType.New)) ? AuraPageData.power_zone_names[state.zone_name_idx] : "";
                    // Pre-2021 firmware ignores the shutdown bit
                    show-shutdown: !root.is_old;
                    boot-checked: state.boot;
                    boot-toggled(value) => {
                        AuraPageData.led_power.states[idx].boot = value;
                        AuraPageData.cb_led_power(AuraPageData.led_power);
                    }
                    awake-checked: state.awake;
                    awake-toggled(value) => {
                        AuraPageData.led_power.states[idx].awake = value;
                        AuraPageData.cb_led_power(AuraPageData.led_power);
                    }
                    sleep-checked: state.sleep;
                    sleep-toggled(value) => {
                        AuraPageData.led_power.states[idx].sleep = value;
                        AuraPageData.cb_led_power(AuraPageData.led_power);
                    }
                    shutdown-checked: state.shutdown;
                    shutdown-toggled(value) => {
                        AuraPageData.led_power.states[idx].shutdown = value;
                        AuraPageData.cb_led_power(AuraPageData.led_power);
                    }
                }
            }
        }
    }
}
