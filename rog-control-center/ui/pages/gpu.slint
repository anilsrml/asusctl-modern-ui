import { ScrollView } from "std-widgets.slint";
import { Theme } from "../theme.slint";
import { Card, SegmentedControl, ToggleRow } from "../widgets/kit.slint";
import { SliderRow, WarningBand } from "../widgets/gpu_widgets.slint";
import { SystemPageData } from "../types/system_types.slint";
import { FanPageData } from "../types/fan_types.slint";

export global GPUPageData {
    // Mode ids in display order: 0 iGPU only, 1 Hybrid, 2 dGPU only (MUX).
    in-out property <[int]> gpu_mode_ids: [];
    in-out property <int> gpu_mode_index: 0; // index into gpu_mode_ids
    in-out property <bool> gpu_switchable: false; // false when no GPU switch exists
    in-out property <bool> gpu_dropdown_enabled: true; // false while a switch is in progress
    in-out property <bool> gpu_reboot_pending: false; // a written mode needs a reboot
    callback cb_set_gpu_mode(int);

    in-out property <bool> has_xgm_led: false; // true when XG Mobile LED is present
    in-out property <bool> xgm_led_enabled: false; // current LED state
    callback cb_set_xgm_led_enabled(bool);

    in-out property <bool> disable_nvidia_powerd_on_battery: true;
    callback cb_disable_nvidia_powerd_on_battery(bool);

    in-out property <int> apu_mem_index: -1; // -1 when apu_mem is not available
    in-out property <[string]> apu_mem_choices: []; // available choices, in display order
    in-out property <bool> apu_mem_present: false; // false when apu_mem is not available
    callback cb_set_apu_mem(int);

    // Slider steps (D-Bus ScalarIncrement) for the attributes shown here.
    in-out property <int> ppt_pl1_step: 1;
    in-out property <int> ppt_pl2_step: 1;
    in-out property <int> ppt_pl3_step: 1;
    in-out property <int> nv_boost_step: 1;
    in-out property <int> nv_temp_step: 1;
    in-out property <int> ppt_fppt_step: 1;
    in-out property <int> ppt_apu_sppt_step: 1;
    in-out property <int> ppt_platform_sppt_step: 1;
    in-out property <int> nv_tgp_step: 1;
    // Snap a raw slider value to min/max/step (implemented in Rust).
    pure callback snap(float, int, int, int) -> int;
}

export component PageGPU inherits Rectangle {
    // The kernel only accepts PPT writes while a custom
    // fan curve is enabled for the active profile.
    property <int> active_profile_value: (SystemPageData.platform_profile >= 0 && SystemPageData.platform_profile < SystemPageData.platform_profile_indexes.length) ? SystemPageData.platform_profile_indexes[SystemPageData.platform_profile] : -1;
    property <bool> fan_curve_active: (active_profile_value == 0 && (FanPageData.balanced_cpu_enabled || FanPageData.balanced_gpu_enabled || FanPageData.balanced_mid_enabled)) || (active_profile_value == 1 && (FanPageData.performance_cpu_enabled || FanPageData.performance_gpu_enabled || FanPageData.performance_mid_enabled)) || ((active_profile_value == 2 || active_profile_value == 3) && (FanPageData.quiet_cpu_enabled || FanPageData.quiet_gpu_enabled || FanPageData.quiet_mid_enabled));
    property <bool> tuning_on: SystemPageData.enable_ppt_group && fan_curve_active;

    property <bool> has_boost: SystemPageData.nv_dynamic_boost.max > 0 && SystemPageData.nv_dynamic_boost.current != -1;
    property <bool> has_temp: SystemPageData.nv_temp_target.max > 0 && SystemPageData.nv_temp_target.current != -1;
    property <bool> has_pl1: SystemPageData.ppt_pl1_spl.max > 0 && SystemPageData.ppt_pl1_spl.current != -1;
    property <bool> has_pl2: SystemPageData.ppt_pl2_sppt.max > 0 && SystemPageData.ppt_pl2_sppt.current != -1;
    property <bool> has_pl3: SystemPageData.ppt_pl3_fppt.max > 0 && SystemPageData.ppt_pl3_fppt.current != -1;
    property <bool> has_fppt: SystemPageData.ppt_fppt.max > 0 && SystemPageData.ppt_fppt.current != -1;
    property <bool> has_apu_sppt: SystemPageData.ppt_apu_sppt.max > 0 && SystemPageData.ppt_apu_sppt.current != -1;
    property <bool> has_platform_sppt: SystemPageData.ppt_platform_sppt.max > 0 && SystemPageData.ppt_platform_sppt.current != -1;
    property <bool> has_tgp: SystemPageData.nv_tgp.max > 0 && SystemPageData.nv_tgp.current != -1;

    // Fixed three labels; ids tell which of them this machine offers.
    property <[string]> modes_all: [@tr("Hybrid"), @tr("iGPU only"), @tr("dGPU only (MUX)")];
    property <[string]> modes_igpu: [@tr("Hybrid"), @tr("iGPU only")];
    property <[string]> modes_mux: [@tr("Hybrid"), @tr("dGPU only (MUX)")];

    background: Theme.window-bg;
    clip: true;

    ScrollView {
        VerticalLayout {
            padding: Theme.pad;
            spacing: Theme.gap;
            alignment: start;

            if !GPUPageData.gpu_switchable && !root.has_boost && !root.has_temp && !root.has_pl1 && !root.has_pl2 && !root.has_pl3 && !root.has_fppt && !root.has_apu_sppt && !root.has_platform_sppt && !root.has_tgp && !GPUPageData.apu_mem_present && !GPUPageData.has_xgm_led: Text {
                text: @tr("This device has no switchable GPU.");
                color: Theme.text-secondary;
                font-size: Theme.font-body;
            }

            if GPUPageData.gpu_switchable: Card {
                title: @tr("GPU mode");
                Rectangle {
                    height: 40px;
                    SegmentedControl {
                        width: parent.width;
                        height: parent.height;
                        model: GPUPageData.gpu_mode_ids.length == 3 ? root.modes_all : (GPUPageData.gpu_mode_ids.length == 2 && GPUPageData.gpu_mode_ids[1] == 0 ? root.modes_igpu : root.modes_mux);
                        current-index <=> GPUPageData.gpu_mode_index;
                        opacity: GPUPageData.gpu_dropdown_enabled ? 1 : 0.5;
                        selected(index) => {
                            GPUPageData.cb_set_gpu_mode(index);
                        }
                    }
                    // Swallow clicks while a switch is being written
                    if !GPUPageData.gpu_dropdown_enabled: TouchArea { }
                }
                Text {
                    text: @tr("Hybrid uses the integrated GPU and wakes the NVIDIA GPU on demand.");
                    color: Theme.text-secondary;
                    font-size: Theme.font-small;
                    wrap: word-wrap;
                }
                if GPUPageData.gpu_reboot_pending: WarningBand {
                    text: @tr("The new GPU mode applies after a reboot.");
                }
            }

            if root.has_boost || root.has_temp || root.has_tgp: Card {
                title: @tr("NVIDIA");
                if !root.tuning_on: Text {
                    text: @tr("Unlock these in the power limits card below.");
                    color: Theme.text-secondary;
                    font-size: Theme.font-small;
                    wrap: word-wrap;
                }
                if root.has_boost: SliderRow {
                    title: @tr("Dynamic Boost");
                    hint: @tr("Extra power the GPU may borrow from the CPU. Higher is faster and hotter.");
                    unit: "W";
                    enabled: root.tuning_on;
                    has-reset: true;
                    minimum: SystemPageData.nv_dynamic_boost.min;
                    maximum: SystemPageData.nv_dynamic_boost.max;
                    value: SystemPageData.nv_dynamic_boost.current;
                    released(raw) => {
                        SystemPageData.nv_dynamic_boost.current = GPUPageData.snap(raw, SystemPageData.nv_dynamic_boost.min, SystemPageData.nv_dynamic_boost.max, GPUPageData.nv_boost_step);
                        SystemPageData.cb_nv_dynamic_boost(Math.round(SystemPageData.nv_dynamic_boost.current));
                    }
                    reset => {
                        SystemPageData.cb_default_nv_dynamic_boost();
                    }
                }
                if root.has_temp: SliderRow {
                    title: @tr("Temperature target");
                    hint: @tr("The GPU slows down once it reaches this temperature.");
                    unit: "°C";
                    enabled: root.tuning_on;
                    has-reset: true;
                    minimum: SystemPageData.nv_temp_target.min;
                    maximum: SystemPageData.nv_temp_target.max;
                    value: SystemPageData.nv_temp_target.current;
                    released(raw) => {
                        SystemPageData.nv_temp_target.current = GPUPageData.snap(raw, SystemPageData.nv_temp_target.min, SystemPageData.nv_temp_target.max, GPUPageData.nv_temp_step);
                        SystemPageData.cb_nv_temp_target(Math.round(SystemPageData.nv_temp_target.current));
                    }
                    reset => {
                        SystemPageData.cb_default_nv_temp_target();
                    }
                }
                if root.has_tgp: SliderRow {
                    title: @tr("GPU power (TGP)");
                    hint: @tr("Total power limit of the NVIDIA GPU. Higher is faster and hotter.");
                    unit: "W";
                    enabled: root.tuning_on;
                    has-reset: true;
                    minimum: SystemPageData.nv_tgp.min;
                    maximum: SystemPageData.nv_tgp.max;
                    value: SystemPageData.nv_tgp.current;
                    released(raw) => {
                        SystemPageData.nv_tgp.current = GPUPageData.snap(raw, SystemPageData.nv_tgp.min, SystemPageData.nv_tgp.max, GPUPageData.nv_tgp_step);
                        SystemPageData.cb_nv_tgp(Math.round(SystemPageData.nv_tgp.current));
                    }
                    reset => {
                        SystemPageData.cb_default_nv_tgp();
                    }
                }
            }

            if root.has_pl1 || root.has_pl2 || root.has_pl3 || root.has_fppt || root.has_apu_sppt || root.has_platform_sppt: Card {
                title: @tr("CPU power limits (PPT)");
                // Reset calls restore_default on the attribute; D-Bus
                // DefaultValue reports 45/54/65 W while the kernel sysfs
                // default is 80 W. The reset behaviour is unchanged.
                if SystemPageData.ppt_enabled_available: ToggleRow {
                    title: @tr("Enable tuning");
                    hint: @tr("Limits below are ignored until tuning is on.");
                    enabled: root.fan_curve_active;
                    checked: SystemPageData.ppt_enabled;
                    toggled(value) => {
                        SystemPageData.ppt_enabled = value;
                        SystemPageData.enable_ppt_group = value;
                        SystemPageData.cb_ppt_enabled(value);
                    }
                }
                if !SystemPageData.ppt_enabled_available: ToggleRow {
                    title: @tr("Enable tuning");
                    hint: @tr("Limits below are ignored until tuning is on.");
                    enabled: root.fan_curve_active;
                    checked: SystemPageData.enable_ppt_group;
                    toggled(value) => {
                        SystemPageData.enable_ppt_group = value;
                        SystemPageData.cb_enable_ppt_group(value);
                    }
                }
                if !root.fan_curve_active: WarningBand {
                    text: @tr("Power limits need a custom fan curve. Turn one on for this profile in the Fans page.");
                }
                if root.has_pl1: SliderRow {
                    title: @tr("PL1 sustained");
                    hint: @tr("Long-term CPU power. Sets steady-state performance and heat.");
                    unit: "W";
                    enabled: root.tuning_on;
                    has-reset: true;
                    minimum: SystemPageData.ppt_pl1_spl.min;
                    maximum: SystemPageData.ppt_pl1_spl.max;
                    value: SystemPageData.ppt_pl1_spl.current;
                    released(raw) => {
                        SystemPageData.ppt_pl1_spl.current = GPUPageData.snap(raw, SystemPageData.ppt_pl1_spl.min, SystemPageData.ppt_pl1_spl.max, GPUPageData.ppt_pl1_step);
                        SystemPageData.cb_ppt_pl1_spl(Math.round(SystemPageData.ppt_pl1_spl.current));
                    }
                    reset => {
                        SystemPageData.cb_default_ppt_pl1_spl();
                    }
                }
                if root.has_pl2: SliderRow {
                    title: @tr("PL2 turbo");
                    hint: @tr("Short-term CPU power for boost bursts.");
                    unit: "W";
                    enabled: root.tuning_on;
                    has-reset: true;
                    minimum: SystemPageData.ppt_pl2_sppt.min;
                    maximum: SystemPageData.ppt_pl2_sppt.max;
                    value: SystemPageData.ppt_pl2_sppt.current;
                    released(raw) => {
                        SystemPageData.ppt_pl2_sppt.current = GPUPageData.snap(raw, SystemPageData.ppt_pl2_sppt.min, SystemPageData.ppt_pl2_sppt.max, GPUPageData.ppt_pl2_step);
                        SystemPageData.cb_ppt_pl2_sppt(Math.round(SystemPageData.ppt_pl2_sppt.current));
                    }
                    reset => {
                        SystemPageData.cb_default_ppt_pl2_sppt();
                    }
                }
                if root.has_pl3: SliderRow {
                    title: @tr("PL3 fast burst");
                    hint: @tr("Very short CPU power spikes for sudden load.");
                    unit: "W";
                    enabled: root.tuning_on;
                    has-reset: true;
                    minimum: SystemPageData.ppt_pl3_fppt.min;
                    maximum: SystemPageData.ppt_pl3_fppt.max;
                    value: SystemPageData.ppt_pl3_fppt.current;
                    released(raw) => {
                        SystemPageData.ppt_pl3_fppt.current = GPUPageData.snap(raw, SystemPageData.ppt_pl3_fppt.min, SystemPageData.ppt_pl3_fppt.max, GPUPageData.ppt_pl3_step);
                        SystemPageData.cb_ppt_pl3_fppt(Math.round(SystemPageData.ppt_pl3_fppt.current));
                    }
                    reset => {
                        SystemPageData.cb_default_ppt_pl3_fppt();
                    }
                }
                if root.has_fppt: SliderRow {
                    title: @tr("Fast package limit");
                    hint: @tr("Millisecond-scale power spikes of the whole package.");
                    unit: "W";
                    enabled: root.tuning_on;
                    has-reset: true;
                    minimum: SystemPageData.ppt_fppt.min;
                    maximum: SystemPageData.ppt_fppt.max;
                    value: SystemPageData.ppt_fppt.current;
                    released(raw) => {
                        SystemPageData.ppt_fppt.current = GPUPageData.snap(raw, SystemPageData.ppt_fppt.min, SystemPageData.ppt_fppt.max, GPUPageData.ppt_fppt_step);
                        SystemPageData.cb_ppt_fppt(Math.round(SystemPageData.ppt_fppt.current));
                    }
                    reset => {
                        SystemPageData.cb_default_ppt_fppt();
                    }
                }
                if root.has_apu_sppt: SliderRow {
                    title: @tr("APU sustained");
                    hint: @tr("Long-term power shared by the CPU and integrated graphics.");
                    unit: "W";
                    enabled: root.tuning_on;
                    has-reset: true;
                    minimum: SystemPageData.ppt_apu_sppt.min;
                    maximum: SystemPageData.ppt_apu_sppt.max;
                    value: SystemPageData.ppt_apu_sppt.current;
                    released(raw) => {
                        SystemPageData.ppt_apu_sppt.current = GPUPageData.snap(raw, SystemPageData.ppt_apu_sppt.min, SystemPageData.ppt_apu_sppt.max, GPUPageData.ppt_apu_sppt_step);
                        SystemPageData.cb_ppt_apu_sppt(Math.round(SystemPageData.ppt_apu_sppt.current));
                    }
                    reset => {
                        SystemPageData.cb_default_ppt_apu_sppt();
                    }
                }
                if root.has_platform_sppt: SliderRow {
                    title: @tr("Platform sustained");
                    hint: @tr("Long-term power limit of the whole system.");
                    unit: "W";
                    enabled: root.tuning_on;
                    has-reset: true;
                    minimum: SystemPageData.ppt_platform_sppt.min;
                    maximum: SystemPageData.ppt_platform_sppt.max;
                    value: SystemPageData.ppt_platform_sppt.current;
                    released(raw) => {
                        SystemPageData.ppt_platform_sppt.current = GPUPageData.snap(raw, SystemPageData.ppt_platform_sppt.min, SystemPageData.ppt_platform_sppt.max, GPUPageData.ppt_platform_sppt_step);
                        SystemPageData.cb_ppt_platform_sppt(Math.round(SystemPageData.ppt_platform_sppt.current));
                    }
                    reset => {
                        SystemPageData.cb_default_ppt_platform_sppt();
                    }
                }
            }

            if GPUPageData.apu_mem_present: Card {
                title: @tr("Reserved GPU memory");
                SegmentedControl {
                    model: GPUPageData.apu_mem_choices;
                    current-index <=> GPUPageData.apu_mem_index;
                    selected(index) => {
                        GPUPageData.cb_set_apu_mem(index);
                    }
                }
                WarningBand {
                    text: @tr("Reserved GPU memory changes apply after a reboot.");
                }
            }

            if GPUPageData.has_xgm_led || SystemPageData.has_dgpu: Card {
                if GPUPageData.has_xgm_led: ToggleRow {
                    title: @tr("XG Mobile LED");
                    hint: @tr("Light on the external GPU dock.");
                    checked <=> GPUPageData.xgm_led_enabled;
                    toggled(value) => {
                        GPUPageData.cb_set_xgm_led_enabled(value);
                    }
                }
                if SystemPageData.has_dgpu: ToggleRow {
                    title: @tr("Disable nvidia-powerd on battery");
                    hint: @tr("Stops the NVIDIA power daemon when unplugged to save power.");
                    checked <=> GPUPageData.disable_nvidia_powerd_on_battery;
                    toggled(value) => {
                        GPUPageData.cb_disable_nvidia_powerd_on_battery(value);
                    }
                }
            }
        }
    }
}
